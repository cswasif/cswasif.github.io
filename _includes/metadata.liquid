{% if site.google_site_verification and site.google_site_verification != '' %}
  <meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.bing_site_verification and site.bing_site_verification != '' %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
{% endif %}
<meta http-equiv="Permissions-Policy" content="interest-cohort=()">

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{% if page.url == '/' or page.url == '/index.html' %}Wasif Faisal | Payment Security Researcher{% elsif page.url == '/blog/index.html' or page.url == '/blog/' %}{{ page.title }} | Wasif Faisal{% elsif page.title != 'blank' and page.url != '/' %}{% if page.title == null or page.title == '' %}{{ page.date | date: '%Y' }} | Wasif Faisal{% else %}{{ page.title }} | Wasif Faisal{% endif %}{% else %}Wasif Faisal | Payment Security Researcher{% endif %}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{% if page.description %}{{ page.description }}{% else %}{{ site.description | strip_newlines | strip }}{% endif %}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="Wasif Faisal | Payment Security Researcher">
  <meta property="og:type" content="{% if is_blog_post %}article{% elsif page.url == '/' %}profile{% else %}website{% endif %}">
  <meta property="og:title" content="{% if page.url == '/' %}Wasif Faisal | Payment Security Researcher{% elsif page.title %}{{ page.title }} | Wasif Faisal{% else %}Wasif Faisal | Payment Security Researcher{% endif %}">
  <meta property="og:url" content="{{ page.url | absolute_url | remove_first: 'index.html' }}">
  <meta property="og:description" content="{% if page.description %}{{ page.description }}{% else %}{{ site.description | strip_newlines | strip }}{% endif %}">
  <meta property="og:locale" content="{{ site.lang | default: 'en' }}">
  {% assign og_img = site.og_image | default: 'assets/img/prof_pic.jpg' %}
  {% unless og_img contains 'assets/img/' or og_img contains '://' %}
    {% assign og_img = og_img | prepend: 'assets/img/' %}
  {% endunless %}
  {% if og_img contains '://' %}
    {% assign og_image_url = og_img %}
  {% else %}
    {% assign og_image_url = og_img | prepend: '/' | prepend: site.url %}
  {% endif %}
  <meta property="og:image" content="{{ og_image_url }}">

  {% if page.url == '/' %}
    <meta property="profile:first_name" content="Wasif">
    <meta property="profile:last_name" content="Faisal">
    <meta property="profile:username" content="cswasif">
  {% elsif is_blog_post %}
    <meta property="article:published_time" content="{{ page.date | date_to_xmlschema }}">
    <meta property="article:author" content="{{ site.url }}/">
    {% for tag in page.tags %}
      <meta property="article:tag" content="{{ tag }}">
    {% endfor %}
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if page.url == '/' %}Wasif Faisal | Payment Security Researcher{% elsif page.title %}{{ page.title }} | Wasif Faisal{% else %}Wasif Faisal | Payment Security Researcher{% endif %}">
  <meta name="twitter:description" content="{% if page.description %}{{ page.description }}{% else %}{{ site.description | strip_newlines | strip }}{% endif %}">
  <meta name="twitter:image" content="{{ og_image_url }}">
{% endif %}

{% if is_blog_post %}
  <!-- Google Scholar / Academic Citation Meta Tags -->
  <meta name="citation_title" content="{{ page.title }}">
  <meta name="citation_author" content="Wasif Faisal">
  <meta name="citation_publication_date" content="{{ page.date | date: '%Y/%m/%d' }}">
  <meta name="citation_online_date" content="{{ page.date | date: '%Y/%m/%d' }}">
  {% if page.arxiv %}
    <meta name="citation_arxiv_id" content="{{ page.arxiv }}">
    <meta name="citation_abstract_html_url" content="https://arxiv.org/abs/{{ page.arxiv }}">
    <meta name="citation_pdf_url" content="https://arxiv.org/pdf/{{ page.arxiv }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org Knowledge Graph (Entity SEO & LLM Grounding) -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "{{ site.url }}/#person",
          "name": "Wasif Faisal",
          "givenName": "Wasif",
          "familyName": "Faisal",
          "additionalName": "Md.",
          "alternateName": ["Md. Wasif Faisal", "cswasif"],
          "url": "{{ site.url }}/",
          "image": "{{ site.url }}/assets/img/prof_pic.jpg",
          "email": "mailto:md.wasif.faisal@g.bracu.ac.bd",
          "jobTitle": "Payment Security Researcher",
          "description": "Independent security researcher specializing in payment security, cyber threat intelligence, EMV 3-D Secure protocol vulnerabilities, and transaction authentication analysis.",
          "alumniOf": {
            "@type": "CollegeOrUniversity",
            "name": "BRAC University",
            "url": "https://www.bracu.ac.bd/"
          },
          "knowsAbout": [
            "Payment Security",
            "EMV 3-D Secure (3DS)",
            "Card-Not-Present (CNP) Fraud",
            "Cyber Threat Intelligence",
            "BIN Attack Methodologies",
            "Transaction Risk and Protocol Analysis",
            "Authentication Oracles"
          ],
          "sameAs": [
            "https://orcid.org/0000-0003-0696-5623",
            "https://scholar.google.com/citations?user=K42crVoAAAAJ",
            "https://github.com/cswasif",
            "https://www.linkedin.com/in/cswasif",
            "https://cnpshield.github.io/3dslab/",
            "https://arxiv.org/a/faisal_w_1.html"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "{{ site.url }}/#website",
          "url": "{{ site.url }}/",
          "name": "Wasif Faisal | Payment Security Researcher",
          "description": "Independent security research portfolio, technical disclosures, and publications on payment security by Wasif Faisal.",
          "publisher": {
            "@id": "{{ site.url }}/#person"
          }
        }
        {% if is_blog_post %}
        ,
        {
          "@type": "TechArticle",
          "@id": "{{ page.url | absolute_url }}#article",
          "headline": {{ page.title | jsonify }},
          "description": {{ page.description | jsonify }},
          "url": "{{ page.url | absolute_url }}",
          "datePublished": "{{ page.date | date_to_xmlschema }}",
          "dateModified": "{{ page.last_updated | default: page.date | date_to_xmlschema }}",
          "author": {
            "@id": "{{ site.url }}/#person"
          },
          "publisher": {
            "@id": "{{ site.url }}/#person"
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ page.url | absolute_url }}"
          },
          "keywords": {{ page.tags | jsonify }}
        }
        {% endif %}
      ]
    }
  </script>
{% endif %}
