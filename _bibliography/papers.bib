@article{faisal2026oracle,
  abbr          = {arXiv},
  bibtex_show   = {true},
  title         = {The 3DS Oracle: BIN Attack via the Network},
  author        = {Faisal, Wasif and Dibya, Suprava Saha},
  journal       = {arXiv preprint arXiv:2610.32206},
  year          = {2026},
  month         = {October},
  url           = {https://arxiv.org/abs/2610.32206},
  html          = {https://arxiv.org/abs/2610.32206},
  pdf           = {https://arxiv.org/pdf/2610.32206},
  selected      = {true},
  abstract      = {EMV 3-D Secure (3DS) requires a client-visible continuation boundary in browser-mediated flows; in some deployments, that boundary exposes a pre-authorization classification channel. This paper studies 3DS as a protocol, integration surface, and governance problem, combining standards analysis, architectural reconstruction, formal modeling, a documentation audit, disclosure history, and a bounded live evaluation. We show that client-visible integrations can reflect routing and authentication state before financial authorization, allowing 3DS to function as a profiling and screening channel for issuer controls and cardholder/account state rather than only as a defense. In the tested browser-channel Braintree/Cardinal path, the first client-visible result separated researcher-owned anchor cards from bounded adjacent same-range comparison PANs in six of seven distinct ACS/card-range cohorts. Meaningful remediation requires consortium-level reform, including stricter minimization of client-visible pre-authorization responses, more uniform continuation behavior, and stronger client authenticity and session binding.}
}

@article{faisal2026prefix,
  abbr          = {arXiv},
  bibtex_show   = {true},
  title         = {Prefix Count Limits Can Increase First-Hit Discovery in Card Reissuance},
  author        = {Faisal, Wasif},
  journal       = {arXiv preprint arXiv:2609.31398},
  year          = {2026},
  month         = {September},
  url           = {https://arxiv.org/abs/2609.31398},
  html          = {https://arxiv.org/abs/2609.31398},
  pdf           = {https://arxiv.org/pdf/2609.31398},
  selected      = {true},
  abstract      = {Identified situations in which caps on how many cards can share a number prefix can make active cards easier to find in a BIN attack (attempts to identify valid card numbers); demonstrated the effect in simulations using 50,000 synthetic candidates. The findings help banks and other card issuers assess reissuance policies for card-number discovery risk, rather than relying on count limits alone.}
}
